# Copy to .env and fill in. Every value below is the default that src/config.cpp
# falls back to when the variable is unset.
#
# The server reads these from the process environment; it does not parse .env
# itself. Load the file into your shell before starting the binary:
#
#   set -a && . ./.env && set +a && ./build/speaking-sim

# API key for the Gemini examiner backend. Required when EXAMINER_BACKEND=gemini
# and GEMINI_API_KEYS below is unset.
GEMINI_API_KEY=

# Optional pool of named Gemini keys the in-browser settings button can pick
# between, e.g. to spread requests across separate quota-limited accounts.
# Format: "Name1=key1,Name2=key2". When set, this replaces GEMINI_API_KEY as
# the source of the default key (its first entry). Leave unset to offer only
# the single GEMINI_API_KEY above, labelled "Default".
GEMINI_API_KEYS=

# API key for the in-app translate box, which calls Google Cloud Translation v2.
#
# NOT the same as a Gemini key: this must be a Google Cloud API key on a project
# with the Cloud Translation API enabled and billing on, or every call comes back
# 403 SERVICE_DISABLED. Console -> APIs & Services -> Credentials -> API key,
# after enabling https://console.cloud.google.com/apis/library/translate.googleapis.com
#
# Kept separate from the Gemini keys on purpose: the examiner keys are rationed
# by a daily request cap, and a lookup box should not eat the exam's budget.
# Leave unset to run without the feature - the box then reports it is not
# configured instead of failing the request.
TRANSLATE_API_KEY=

# Which examiner to use: gemini or hailo.
# Anything other than the exact string "hailo" selects gemini.
EXAMINER_BACKEND=gemini

# The Gemini model id. Configurable because it has moved three times already,
# and each move used to mean editing a constant and rebuilding.
GEMINI_MODEL=gemini-3.8-flash

# How much the examiner thinks before answering: low, medium or high.
#
# Gemini 3.x takes this enum rather than the 2.5-series thinkingBudget integer,
# and 3.8 dropped the "minimal" that 3.5 and 3.6 accepted - sending it now is a
# 400 on every turn. Anything outside the three values falls back to low, with a
# line on stderr, rather than letting the server start into a broken state.
#
# The opening question gets its own setting. It has no student answer to reason
# about, and thinking there collapses the sampling distribution: the model
# reasons its way to the one canonical easiest-beginner-question and every exam
# opens the same way. Low keeps it varied and takes latency off the turn the
# student waits through before the exam starts.
GEMINI_THINKING_LEVEL=low
GEMINI_OPENING_THINKING_LEVEL=low

# Where the student's recorded answer is transcribed: gemini or whisper.
#
# gemini sends the captured audio to the examiner, which returns the transcript
# and its reply in one response. It hears hesitation, accent and self-correction
# that a transcript throws away, and it transcribes with the question it just
# asked for context, which local whisper never sees.
#
# whisper keeps the audio on this machine and sends the examiner text only.
# Whisper stays loaded either way: if the examiner call fails or comes back
# without a transcript, it takes over so the student still sees their words.
AUDIO_INPUT=gemini

# How that audio is encoded for the examiner: flac or wav.
#
# Both are lossless and carry identical samples, so neither affects what the
# model hears. wav is the captured buffer plus a 44-byte header and needs no
# encoder; flac roughly halves the bytes on the wire at a few ms of CPU.
#
# Which one wins depends on this server's uplink, not the student's connection:
# the student's audio reaches us over the WebSocket as raw PCM either way. On a
# home uplink flac is worth real time per turn; from a datacentre it saves
# milliseconds against an examiner call measured in hundreds. Measure with the
# "turn timings" log line before assuming.
AUDIO_CODEC=flac

# Base URL of the local Ollama-compatible server the hailo backend talks to over
# plain HTTP. No Hailo SDK is involved.
HAILO_OLLAMA_URL=http://localhost:11434

# Path to the whisper.cpp GGML model used for speech to text.
WHISPER_MODEL_PATH=models/ggml-base.bin

# Path to the piper ONNX voice model used for text to speech. This one is the
# Italian voice; German picks its own from LANGUAGE_VOICES below.
PIPER_MODEL_PATH=models/it_IT-riccardo-x_low.onnx

# Optional per-language voice overrides, "id=path" pairs separated by commas,
# the same shape as GEMINI_API_KEYS. Leave it unset and each language uses the
# voice named in src/language.cpp, which is what the files in models/ are.
# Set it only to point a language at a different voice:
# LANGUAGE_VOICES=italian=models/it_IT-riccardo-x_low.onnx,german=models/de_DE-thorsten-low.onnx
#
# Each voice needs its .onnx.json beside it: piper reads the sample rate from
# there, and a missing one plays that language back at the wrong pitch.

# How long a speaking exam runs, in seconds (60 to 3600). The server starts its
# own clock when the opening question goes out and tells the browser this
# figure; an answer submitted after it is transcribed but earns no further
# question, whatever the page says.
EXAM_DURATION_SECONDS=300

# Examiner questions per account per day, the opening question included. Free
# accounts get the first; accounts with a licence (their own, or one of their
# classes') and teachers get the second. 0 switches speaking off for that tier.
# Listening is never metered. The day is the server's local date, so set TZ
# (e.g. TZ=Australia/Sydney) for the allowance to reset at local midnight.
FREE_DAILY_QUESTIONS=5
PAID_DAILY_QUESTIONS=200

# TCP port the HTTP and WebSocket server listens on.
PORT=8080

# Size of the pipeline worker pool. A turn holds one worker for its whole
# STT -> examiner -> TTS chain, so this is how many students can be mid-turn at
# once; the rest are refused with a "busy" status. 0 or unset derives it from
# the CPU count, falling back to 2 when that cannot be determined.
#
# Prefer a small number over the CPU count. Each worker keeps its OWN keep-alive
# HTTPS connection to Gemini (the client is thread_local), and a fresh TLS
# handshake to that host measures 150-490ms. Eight workers means eight
# connections to keep warm and a poor chance that consecutive turns reuse one,
# while a single student never has more than one turn in flight anyway. Raise it
# only if several students really do share the server.
WORKER_THREADS=2

# Where the accounts, classes and exam-history database lives. Relative paths
# resolve against the working directory, which is speaking-sim/ like every
# other path here. The file, its -wal and -shm sidecars are gitignored.
DATABASE_PATH=speaking-sim.db

# ---------------------------------------------------------------------------
# Google sign-in (OAuth 2.0, Authorization Code + PKCE)
# ---------------------------------------------------------------------------
# From a Web application OAuth client in Google Cloud Console. The client's
# "Authorized redirect URIs" must contain PUBLIC_ORIGIN + /auth/callback,
# matched by Google as a literal string - one stray character, a trailing
# slash, or 127.0.0.1 in place of localhost is a redirect_uri_mismatch.
#
# For the defaults below that URI is exactly:
#     http://localhost:8080/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The origin a browser reaches this server on. One value drives three things:
# the redirect_uri sent to Google, whether the session cookie is marked Secure,
# and ws:// against wss://. Moving to a real domain is this line plus the
# matching redirect URI in the Google console.
PUBLIC_ORIGIN=http://localhost:8080

# Whether sign-in is enforced. While false the pages and routes exist, nothing
# is gated, and an exam still runs for a browser that never signed in. Turning
# it on with the two keys above empty is a startup error rather than a server
# that refuses every request.
AUTH_REQUIRED=false

# Comma separated addresses allowed to create classes and open the teacher
# dashboard at /teacher. Everyone else is a student, who joins a class with its
# code, a /join link, or by being on its email roster. Case insensitive; spaces
# are trimmed. Removing an address later does not demote an existing teacher.
TEACHER_EMAILS=

# ---------------------------------------------------------------------------
# Safety screening
# ---------------------------------------------------------------------------
# Two checkpoints per turn: the student's transcript before the examiner is
# called, and the examiner's reply before anything is spoken or stored. See
# docs/compliance/compliant-flow.md.

# off | local | azure. An unrecognised value is a startup error rather than a
# silent fall back to the permissive one.
#   off    nothing is screened. Development only, and REFUSED outright once
#          AUTH_REQUIRED=1
#   local  the wordlist layer alone. No network, no key, no cost - this is the
#          build that still works on the Pi with the cable out
#   azure  wordlist first, then Content Safety and Prompt Shields in
#          Australia East
SAFETY_MODE=local

# Where the per-language lists live. Each <language>/ holds profanity.txt,
# jailbreak.txt and escalate.txt; the tracked *.txt.example beside each is read
# when the live file is absent. See config/wordlists/README.md.
SAFETY_WORDLIST_DIR=config/wordlists

# A screening layer that throws halts the turn. Only ever turned off for the
# offline build, which has no layer that can throw in the first place.
SAFETY_FAIL_CLOSED=1

# Jailbreak and prompt-injection detection on student speech. Azure mode only.
SAFETY_SHIELD_PROMPTS=1

# Azure mode only. The resource MUST be in Australia East: a Content Safety
# resource in another region is the same compliance failure as the examiner
# being in another region, and is easier to create by accident.
CONTENT_SAFETY_ENDPOINT=

# Leave EMPTY in the deployed configuration. The relay's managed identity holds
# Cognitive Services User on the resource, and a key that does not exist cannot
# be leaked in a log line. This is here for local testing only.
CONTENT_SAFETY_KEY=

# 0, 2, 4 or 6 on the four-level scale. 2 stops anything the service is willing
# to call low severity - deliberately stricter than the service default,
# because the users are minors.
CONTENT_SAFETY_HALT_SEVERITY=2

# NOTE on AUDIO_INPUT above: setting AUTH_REQUIRED=1 while AUDIO_INPUT=gemini
# is refused at startup. That path hands the recording to the model, which
# transcribes and replies in one call, so there is no transcript to screen
# before the model reads it and the student-speech checkpoint cannot run at
# all. Use AUDIO_INPUT=whisper for anything a student other than you will
# speak into.

# ---------------------------------------------------------------------------
# Semantic reasoning pass (the adjudicator)
# ---------------------------------------------------------------------------
# When a filter fires, the flagged text can be sent back to the examiner for a
# reasoning pass that says whether the trigger was genuine. This is what tells
# "mi piace da morire" (an idiom) from "voglio morire" (a disclosure), and a
# WWII history answer from a violent threat - distinctions no wordlist or
# severity score can make.
#
# The rule it is built around, and the one to quote in an assessment request:
#
#     adjudication resolves disagreement between detectors;
#     it never overrides consensus.
#
# off | examiner. Off by default: the system is correct without it, and turning
# it on is a decision someone signs off.
SAFETY_ADJUDICATOR=off

# Which categories a reasoning pass may review. A cleared verdict falls to
# Allow, EXCEPT self-harm which falls only to Halt. A clearance never discards
# what the other layers concluded: if the wordlist masked a word and Content
# Safety then halted the masked copy, clearing the halt lets the turn continue
# with the mask still applied.
#
# jailbreak and profanity are never reviewable and are dropped from this list
# if written here - the first
# because the text being judged is text that just tried to subvert a model, the
# second because an exact match on a curated list has no ambiguity to resolve.
SAFETY_ADJUDICATE_CATEGORIES=sexual,violence,hate

# Self-harm has its own flag rather than a place in the list above, so it cannot
# be switched on by editing a comma-separated string. Even when this is 1, all
# four of these hold:
#   * at least TWO detectors must be configured. One cannot disagree with
#     itself, so a lone escalation is the only judgement there is and letting a
#     model overturn it would be a veto rather than a tie-break. This is why the
#     flag does nothing under SAFETY_MODE=local, and the server says so at
#     startup rather than leaving it to be discovered;
#   * a verdict those two detectors AGREED on is never reviewed;
#   * an escalate.txt entry prefixed "!" is never reviewed;
#   * a cleared escalation falls only as far as Halt, never to Mask or Allow.
SAFETY_ADJUDICATE_SELF_HARM=0
