# Build output
build/
build-*/
cmake-build-*/
out/
_deps/

# CMake artefacts, in case a configure ever runs outside a build directory
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
compile_commands.json

# Compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.exp
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# Local secrets. .env.example is the tracked template.
.env
!.env.example

# Model weights are large and fetched separately. Keep the directory marker.
models/*
!models/.gitkeep

# Editor and tooling
.vscode/
.idea/
.cache/
*.swp
.DS_Store

# Local notes, not tracked
/NOTES.md
/docs
# Listening clips: mp3 split from past papers, regenerated by the NIBAF/NGBAF
# split_audio.py rather than tracked here. The manifests beside them stay tracked
listening/*/clips/

# Wordlists are deployment data: a school adds the terms its own students use,
# and a repository for a language marking rubric is a poor place to keep a list
# of slurs. The tracked *.txt.example seeds beside them are the fallback the
# loader reads when the live file is absent, so a fresh clone is still screened.
config/wordlists/*/*.txt

# The accounts / classes / exam-history database, plus WAL sidecars.
*.db
*.db-wal
*.db-shm
